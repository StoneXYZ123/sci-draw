# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sci_draw

# Auth (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Storage / CDN — leave blank to keep generated files on local disk
# and serve them from /api/media/image-results/...
# Source images (purpose ai-drawing-source) use the same R2 settings.
# Without them, the app signs a short-lived PUT to /api/storage/local-upload.
# LOCAL_MEDIA_DIR=   # optional, defaults to apps/web/.data
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
CDN_PUBLIC_BASE=

# Image generation. gemini uses GEMINI_API_KEY; if the key is empty the
# server falls back to the mock provider (a local placeholder PNG).
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Convert. opensource uses potrace for SVG paths, a text-layer stub for
# text-only SVG, pptxgenjs for PPTX, and sharp for PNG/TIFF (PDF wraps the PNG).
CONVERT_PROVIDER=opensource

# VSDX. Leave unset (or set none) to record a failed job and skip the charge.
# mock writes a small development Visio package in-process and charges 0 credits.
# It is not a certified Visio file. cloudconvert charges 20 credits when CLOUDCONVERT_API_KEY is set.
# cloudconvert calls CloudConvert only when CLOUDCONVERT_API_KEY is set;
# without the key the route stays on the no-charge NOT_IMPLEMENTED path.
# The worker is the same in-process after() used for drawing jobs. Inngest is
# not required for this single-process poll.
# CONVERT_VSDX_PROVIDER=mock
# CLOUDCONVERT_API_KEY=

# SciVis. Leave SCIVIS_SANDBOX unset to pick E2B when E2B_API_KEY is set,
# otherwise Modal when MODAL_TOKEN_ID, MODAL_TOKEN_SECRET, and
# SCIVIS_MODAL_ENDPOINT are all set, otherwise the local runner.
# local runs the matplotlib/seaborn script with python3 when those libraries
# are installed. Without them the same script is returned with a placeholder
# PNG and engine "mock". Supplied Python (currentCode) runs only in E2B or Modal;
# on the local runner that request fails and the credit hold is released.
# A non-zero sandbox exit or a timeout also releases the hold. There is no retry fee.
# XLSX export of a finished chart costs 10 credits and returns an editable workbook
# (data sheet plus chart metadata). CSV, TSV, and TXT are plotted.
# XLSX and XLS can be uploaded, then the stream returns 400 and does not charge.
# When a remote sandbox and GEMINI_API_KEY are both set, the server may ask Gemini
# (SCIVIS_LLM_MODEL, default gemini-2.0-flash) to rewrite the script before running it.
# SCIVIS_SANDBOX=local
# E2B_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# SCIVIS_MODAL_ENDPOINT=
# SCIVIS_LLM_MODEL=gemini-2.0-flash
# Modal endpoint contract: POST JSON { code, csv, filename } with headers
# modal-key and modal-secret. Respond 200 { pngBase64, pdfBase64? }.

# Credits granted once when a user is created.
CREDITS_SIGNUP_BONUS=20

# Stripe test mode only. Leave blank to disable purchases (checkout returns 503).
# Do not put live keys (sk_live_) here. This app is a single Node process and
# after() is not a durable queue, so live charges stay off until a queue exists.
# Packs: 100, 500, and 2000 credits. Checkout stores metadata.expectedAmountTotal
# in cents. The webhook grants credits only when session.amount_total matches it
# (reason purchase.stripe, once per Checkout Session id). Defaults when the
# amount vars are unset: 500, 2000, and 8000 cents. Set them to the Price
# unit_amount. A mismatch is ignored and does not credit.
# stripe listen --forward-to localhost:3000/api/billing/webhook
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_
# STRIPE_PRICE_100=price_
# STRIPE_PRICE_500=price_
# STRIPE_PRICE_2000=price_
# STRIPE_AMOUNT_CENTS_100=500
# STRIPE_AMOUNT_CENTS_500=2000
# STRIPE_AMOUNT_CENTS_2000=8000

LOG_LEVEL=info
